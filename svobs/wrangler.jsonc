{
  "name": "svobs",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets"
  },
  "routes": [
    {
      "pattern": "siyerobs.com",
      "custom_domain": true
    },
    {
      "pattern": "www.siyerobs.com",
      "custom_domain": true
    }
  ]
}
